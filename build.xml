<?xml version="1.0"?>
<project name="web.lab3" default="build">
    <property file="build.properties"/>

    <!--    mvn dependency:copy-dependencies -DoutputDirectory=lib-->

    <path id="classpath">
        <fileset dir="${lib.dir}" includes="**/*.jar"/>
    </path>


    <target name="compile" depends="clean">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" classpathref="classpath" includeAntRuntime="false"/>
    </target>


    <target name="build" depends="compile">
        <copy todir="${build.dir}">
            <fileset dir="${webapp.dir}"/>
        </copy>
        <copy todir="${build.dir.lib}">
            <fileset dir="${lib.dir}"/>
        </copy>
        <copy todir="${classes.dir}">
            <fileset dir="${resources.dir}"/>
        </copy>

        <war destfile="${build.dir}/${ant.project.name}.war" webxml="${build.dir}/WEB-INF/web.xml">
            <fileset dir="${build.dir}">
                <include name="**/*.*"/>
            </fileset>
            <classes dir="${classes.dir}"/>
        </war>
    </target>


    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="xml">
        <xmlvalidate lenient="yes" failonerror="true">
            <fileset dir="${src.dir}" includes="**/*.xml"/>
        </xmlvalidate>
    </target>

    <target name="doc">

        <mkdir dir="${build.dir}/javadoc"/>
        <javadoc sourcepath="${java.dir}" destdir="${build.dir}/javadoc" classpathref="classpath">
            <doctitle>${ant.project.name} API Documentation</doctitle>
            <classpath refid="classpath"/>
        </javadoc>

        <mkdir dir="${build.dir}/checksums"/>
        <checksum todir="${build.dir}/checksums" algorithm="MD5">
            <fileset dir="${build.dir}"/>
        </checksum>
        <checksum todir="${build.dir}/checksums" algorithm="SHA-1">
            <fileset dir="${build.dir}"/>
        </checksum>

        <mkdir dir="${build.dir}/META-INF"/>
        <manifest file="${build.dir}/META-INF/MANIFEST.MF">
            <attribute name="Created-By" value="Apache Ant"/>
            <attribute name="Built-By" value="${user.name}"/>
        </manifest>

        <jar destfile="${build.dir}/${ant.project.name}-doc.jar"
             basedir="${build.dir}/javadoc"
             manifest="${build.dir}/META-INF/MANIFEST.MF"/>

    </target>

    <target name="history">

    </target>


    <target name="env">
        <property file="build.properties"/>

        <mkdir dir="${classes.dir}"/>

        <javac srcdir="${java.dir}" destdir="${classes.dir}"
               classpathref="classpath" source="${compile.version}" includeantruntime="false">
            <!-- includeantruntime ="false" — не включать jar самого Ant в classpath. -->
            <compilerarg line="${vm.args}"/>
        </javac>

        <copy todir="${classes.dir}">
            <fileset dir="${resources.dir}"/>
        </copy>

        <!-- Собираем war -->
        <antcall target="build"/>
    </target>


    <target name="team">
        <!-- Получаем текущий коммит -->
        <exec executable="git" outputproperty="git.head" failonerror="true">
            <arg value="rev-parse"/>
            <arg value="HEAD"/>
        </exec>
        <echo>Текущий коммит: ${git.head}</echo>

        <!-- Получаем 2 предыдущих ревизии -->
        <exec executable="git" outputproperty="git.rev1" failonerror="true">
            <arg value="rev-parse"/>
            <arg value="HEAD~1"/>
        </exec>
        <echo>Ревизия 1: ${git.rev1}</echo>

        <exec executable="git" outputproperty="git.rev2" failonerror="true">
            <arg value="rev-parse"/>
            <arg value="HEAD~2"/>
        </exec>
        <echo>Ревизия 2: ${git.rev2}</echo>

        <!-- Создаём папку для сохранения jar -->
        <mkdir dir="${build.dir}/jars"/>

        <!-- Сборка для первой ревизии -->
        <echo>Сборка для ревизии: ${git.rev1}</echo>
        <exec executable="git" failonerror="true">
            <arg value="checkout"/>
            <arg value="${git.rev1}"/>
        </exec>

        <!-- Очищаем build (по необходимости)
        <delete dir="${build.dir}" failonerror="false"/> -->

        <!-- Вызываем сборку -->
        <antcall target="build"/>

        <!-- Копируем jar в отдельную папку с именем ревизии -->
        <mkdir dir="${build.dir}/jars/${git.rev1}"/>
        <copy file="${build.dir}/${ant.project.name}.jar" todir="${build.dir}/jars/${git.rev1}"/>

        <!-- Сборка для второй ревизии -->
        <echo>Сборка для ревизии: ${git.rev2}</echo>
        <exec executable="git" failonerror="true">
            <arg value="checkout"/>
            <arg value="${git.rev2}"/>
        </exec>

        <delete dir="${build.dir}" failonerror="false"/>
        <antcall target="build"/>

        <mkdir dir="${build.dir}/jars/${git.rev2}"/>
        <copy file="${build.dir}/${ant.project.name}.jar" todir="${build.dir}/jars/${git.rev2}"/>

        <!-- Упаковываем оба jar в zip -->
        <zip destfile="${build.dir}/team-jars.zip">
            <fileset dir="${build.dir}/jars">
                <include name="**/*.jar"/>
            </fileset>
        </zip>

        <!-- Возвращаемся к исходному коммиту -->
        <echo>Возвращаемся на исходный коммит ${git.head}</echo>
        <exec executable="git" failonerror="true">
            <arg value="checkout"/>
            <arg value="${git.head}"/>
        </exec>
    </target>


</project>